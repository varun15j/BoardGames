<?xml version="1.0" encoding="utf-8"?>
<!-- Player photos stay on this phone: no cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/avatars"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/avatars"/>
    </device-transfer>
</data-extraction-rules>
